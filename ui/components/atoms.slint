// Shared atoms for the Setup views. No style decisions live here.
// Colors come from Theme. See ui/components/theme.slint.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { LineEdit } from "line_edit.slint";
import { Theme } from "theme.slint";

// A small section heading. Serif, like the web UI headings.
export component SectionTitle inherits Text {
    in property <string> label;
    text: label;
    font-size: 19px;
    font-family: Theme.heading-font;
    font-weight: 600;
    color: Theme.ink;
}

// A label above a single-line input.
export component LabeledInput inherits VerticalBox {
    padding: 0px;
    in property <string> label;
    in property <string> hint;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> enabled: true;
    spacing: 6px;
    Text { text: label; font-size: 14px; font-weight: 600; color: Theme.ink; }
    LineEdit {
        text <=> value;
        placeholder-text: hint;
        input-type: password ? InputType.password : InputType.text;
        enabled: enabled;
    }
}

// A selectable card, used for proactivity levels and permission modes.
// Pressed feedback is immediate: the background answers the tap while
// the finger is down. The selected state animates. Both are motion that
// communicates, not decoration. Durations are 0 when reduce-motion is on.
export component ChoiceCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> reduce-motion: false;
    callback clicked();
    border-radius: 8px;
    border-width: 1px;
    border-color: selected || touch.pressed ? Theme.slate : Theme.line;
    background: selected || touch.pressed ? Theme.slate-soft : touch.has-hover ? Theme.hover : Theme.raised;
    animate background { duration: reduce-motion ? 0ms : 150ms; }
    animate border-color { duration: reduce-motion ? 0ms : 150ms; }
    VerticalBox {
        padding: 10px;
        spacing: 2px;
        Text { text: title; font-family: Theme.heading-font; font-weight: 600; color: Theme.ink; }
        Text { text: detail; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Progress through the onboarding steps. The steps are genuinely
// sequential, so numbering them encodes real order. The fill bar is the
// progress; its width animates when a step completes. Display only: going
// back is the Back button on each step, not a tap on the indicator.
export component StepIndicator inherits VerticalBox {
    padding: 0px;
    in property <[string]> labels;
    in property <int> current;
    in property <[bool]> done;
    in property <float> progress; // 0.0 to 1.0, from the Rust side
    in property <bool> reduce-motion: false;
    spacing: 8px;
    HorizontalBox {
        padding: 0px;
        spacing: 4px;
        for label[idx] in labels: Text {
            text: done[idx] ? "✓ " + label : label;
            font-size: 14px;
            font-weight: idx == current ? 700 : 400;
            color: done[idx] ? Theme.slate : idx == current ? Theme.talon : Theme.muted;
            horizontal-stretch: 1;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
        Rectangle {
            height: 100%;
            width: parent.width * progress;
            border-radius: 2px;
            background: Theme.slate;
            animate width { duration: reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
        }
    }
}
// One sidebar destination or recent conversation. Replaces the std
// checkable Button, whose cupertino-dark checked state draws accent-blue
// text on a grey fill (1.19:1, measured from a headless render). Selected is ink on slate-soft with a
// slate accent bar, which reads as "you are here" at AA contrast. Tab
// focus draws a 2px slate ring; Enter or Space activates.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> selected;
    in property <bool> reduce-motion: false;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }

    // Rows give up height before the sidebar overflows the 560px window.
    min-height: 28px;
    preferred-height: 34px;
    vertical-stretch: 0;
    border-radius: 7px;
    background: selected ? Theme.slate-soft : touch.pressed ? Theme.border-strong : touch.has-hover ? Theme.hover : transparent;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Theme.slate;
    animate background { duration: reduce-motion ? 0ms : 150ms; easing: ease-in-out; }

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: selected ? Theme.slate : transparent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        if has-icon: Image {
            width: 17px;
            source: icon;
            image-fit: contain;
            colorize: selected ? Theme.slate : Theme.icon;
        }
        Text {
            text: label;
            font-size: 14px;
            font-weight: selected ? 600 : 400;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == Key.Space) && !event.repeat) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One option in a single-choice row (permission mode, proactivity level).
// Selected fills with slate and slate-ink text (about 9:1), unselected is
// a raised pill with a line border and ink text, so the chosen option is
// the only filled one in the row. Focus draws a ring outside the pill so
// it stays visible on the slate fill. Disabled keeps the selection
// visible but quiet.
export component ChoiceChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> reduce-motion: false;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: 32px;
    min-width: chip-text.preferred-width + 28px;
    preferred-width: chip-text.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: 16px;
    border-width: 1px;
    border-color: selected ? Theme.slate : touch.has-hover && enabled ? Theme.border-strong : Theme.line;
    background: !enabled ? (selected ? Theme.slate-soft : transparent)
        : selected ? Theme.slate
        : touch.pressed ? Theme.border-strong
        : touch.has-hover ? Theme.hover
        : Theme.raised;
    animate background { duration: reduce-motion ? 0ms : 150ms; easing: ease-in-out; }
    animate border-color { duration: reduce-motion ? 0ms : 150ms; easing: ease-in-out; }

    chip-text := Text {
        text: label;
        font-size: 14px;
        font-weight: selected ? 600 : 400;
        color: !enabled ? Theme.muted : selected ? Theme.slate-ink : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.slate;
        visible: keyboard.has-focus;
    }

    keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == Key.Space) && !event.repeat) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
