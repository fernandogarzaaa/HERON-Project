// A crafted button with a clear hierarchy. Every button in the app is
// this one: product actions (Send / Stop in the composer, Allow / Deny
// on an approval card) use it directly, and every other button goes
// through the std-compatible wrapper in button.slint. The native
// std-widgets Button was a grey slab that ignored the theme's
// elevation tokens, so it is no longer used.
// kind is "primary" (slate), "secondary" (surface with a line border),
// or "danger" (red). Hover and press follow the shell's own button
// pattern in ui/main.slint: an accent border on hover, a softer
// background with the accent text color on press. Gold is not used
// here; it is reserved for "waiting for you". Disabled is a muted
// state, not an invisible one. The user always sees what the next
// action is. The label sits inside 14px side padding, so a button
// without an explicit width is as wide as its label. An optional icon
// sits before the label in the label's colour.
// Colors come from the shared flat Theme (dark values). reduce-motion
// arrives as a property from the window, the shell's pattern, and
// zeroes the transition. Durations match the shell: 150ms feedback.
// Slint =1.18.1, per ~/workspace/HERON-Slint-Plan.md.

import { Theme } from "theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    in property <bool> pill: false;
    in property <bool> reduce-motion: false;
    in property <image> icon;
    callback clicked();

    // Custom-painted controls still need a semantic button and a
    // screen-reader activation path, not just a mouse TouchArea.
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    property <color> base: kind == "primary" ? Theme.slate : kind == "danger" ? Theme.danger : Theme.surface;
    property <color> press-bg: kind == "primary" ? Theme.slate-soft : kind == "danger" ? Theme.danger-soft : Theme.slate-soft;
    property <color> press-text: kind == "primary" ? Theme.slate : kind == "danger" ? Theme.danger : Theme.ink;
    property <color> label-color: !enabled ? Theme.muted : touch.pressed ? press-text : kind == "secondary" ? Theme.ink : Theme.slate-ink;

    height: 36px;
    border-radius: pill ? 18px : 8px;
    // Secondary keeps a resting line border: its fill is Theme.surface,
    // the same as the content area, so without one it reads as bare text.
    border-width: kind == "secondary" || keyboard.has-focus || touch.has-hover || !enabled ? 1px : 0px;
    border-color: keyboard.has-focus ? Theme.slate : touch.has-hover ? Theme.slate : Theme.line;
    background: !enabled ? Theme.line : touch.pressed ? press-bg : base;
    animate background { duration: reduce-motion ? 0ms : 120ms; easing: ease-out; }
    animate border-color { duration: reduce-motion ? 0ms : 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.label-color;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: label;
            font-size: 14px;
            font-weight: kind == "primary" || kind == "danger" ? 600 : 400;
            color: root.label-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Tab focuses this control; Enter/Space activate it without allowing
    // key repeats to fire multiple requests. Avoid focus-on-click here:
    // an unfocused FocusScope can consume the first pointer press.
    keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == Key.Space) && !event.repeat) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
