// Theme: named colors and fonts for the Setup views.
//
// All three plan decisions are settled. Widget style per OS: cupertino
// on macOS, fluent on Windows and Linux, pinned per target in build.rs
// by the Shell lane. The style is a compile-time choice in build.rs, not
// a property here. This file carries Heron's dark palette as custom
// theme properties, per the plan recommendation (section 8, item 2).
//
// Values are measured from assets/index.html, dark media query
// (lines 21-25). The brand hexes slate #2F6690 and talon #C98F00 are the
// light-mode values. In dark mode they lighten to #7DB3D8 and #EDB92B
// for contrast on dark surfaces. Headings use the web UI serif stack.

export global Theme {
    in-out property <color> slate: #7DB3D8;
    in-out property <color> slate-ink: #0D1B26;
    in-out property <color> slate-soft: #1D3040;
    in-out property <color> talon: #EDB92B;
    in-out property <color> talon-soft: #352C0F;
    in-out property <color> talon-ink: #F6E3A6;
    in-out property <color> surface: #17212A;
    in-out property <color> paper: #10181F;
    in-out property <color> ink: #E3EAF0;
    in-out property <color> muted: #93A4B3;
    in-out property <color> line: #293642;
    in-out property <color> danger: #EC7A6F;
    in-out property <color> danger-soft: #3A1D1A;
    in-out property <color> ok: #6EC49C;
    // Round 1 redesign tokens (2026-11-14). Existing tokens above do
    // not change. raised is one step above surface, for cards, the
    // composer, and message containers. hover is the nav and row hover
    // background. border-strong is for focused and active elements.
    // icon is brighter than muted so 16px glyphs stay legible;
    // icon-active matches ink. badge matches talon; badge text is
    // slate-ink.
    in-out property <color> raised: #1C2833;
    in-out property <color> hover: #22303C;
    in-out property <color> border-strong: #3A4A58;
    in-out property <color> icon: #A8B8C4;
    in-out property <color> icon-active: #E3EAF0;
    in-out property <color> badge: #EDB92B;
    in-out property <string> heading-font: "Iowan Old Style, Sitka Display, Sitka Text, Constantia, Charter, Georgia, serif";
}
