// Heron native shell. The window, the sidebar, the view switcher, and
// the chat view. The Views lane fills the other views beside the chat;
// they share the MainWindow properties and the bridge contract in
// docs/slint-bridge.md.
//
// Design bar (Inan, 2026-11-13): "make it beautiful, more interactive, more
// intuitive to use." The shell carries it: Heron's dark palette as the
// Theme global (ui/components/theme.slint, copied from the Setup lane's
// worktree with one word added: `export`, which Slint requires for a global
// another file imports; the integration keeps one copy), serif headings,
// animated feedback on every interactive element, and a sidebar that makes the
// next action obvious. Animation budget: 150ms for sidebar feedback, 180ms for
// view fades, 0ms when reduce-motion is on. See docs/slint-bridge.md.

import { AboutSlint, StandardButton } from "std-widgets.slint";
import { Theme } from "components/theme.slint";
import { ChatMsg } from "components/message.slint";
import { ChatView } from "views/chat.slint";
import { Sidebar } from "views/sidebar.slint";
import { MemoryView } from "views/memory.slint";
import { TasksView } from "views/tasks.slint";
import { RemindersView } from "views/reminders.slint";
import { AwarenessView } from "views/awareness.slint";
import { ActivityView } from "views/activity.slint";
import { UsageView } from "views/usage.slint";
import { SessionRow, MemoryRow, TaskRow, ScheduleRow, RunStepRow, InboxRow, SuggestionRow, SimpleRow, AuditRow, UsageDayRow, ModelRow } from "views/common.slint";

// About dialog. A separate exported Dialog component: a Dialog nested in
// MainWindow stays embedded in the parent window instead of opening a
// separate native window. Shown from Rust (on_show_about in main.rs).
// StandardButton must be a direct child of Dialog, not inside the main
// layout: only then does Slint generate the ok_clicked callback for Rust.
// AboutSlint is the royalty-free Slint license attribution for binaries.
export component AboutDialog inherits Dialog {
    title: "About Heron";
    in-out property <string> app-version: "";

    VerticalLayout {
        spacing: 8px;
        padding: 16px;
        Text {
            text: "Heron";
            font-family: Theme.heading-font;
            font-size: 20px;
            font-weight: 700;
            color: Theme.ink;
        }
        Text {
            text: "Version " + root.app-version;
            color: Theme.ink;
        }
        Text {
            text: "A local-first, private, proactive personal AI agent.";
            color: Theme.ink;
            wrap: word-wrap;
        }
        AboutSlint { }
    }

    // Dialog buttons must be direct children to generate on_ok_clicked.
    StandardButton {
        kind: ok;
    }
}

export component MainWindow inherits Window {
    title: "Heron";
    background: Theme.paper;
    min-width: 880px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 700px;

    // Server connection. backend-status is the status line the shell polls
    // every 30 seconds; error-message is set once when the backend fails to
    // start, and stays empty in normal use.
    in-out property <string> backend-status: "Starting…";
    in-out property <string> error-message: "";
    // Current conversation id, owned by Rust. Empty means "no session yet";
    // the server creates one lazily on the first message sent.
    in-out property <string> session-id: "";
    in-out property <string> session-title: "";
    in-out property <[ChatMsg]> messages: [];
    in-out property <bool> busy: false;
    // Chat state, posted by Rust from the ChatView state machine. The
    // thread is a plain model of ChatMsg rows; the row identity problem
    // the old reply-row property solved is gone, because Rust rewrites
    // the exact turn row on every event. chat-mode is the server mode
    // ("readonly", "ask", "auto", "yolo"), kept in sync by the state
    // poll. starters are the suggestion prompts for the empty state.
    // thread-version bumps on every thread mutation so the view can
    // follow the scroll to the bottom.
    in-out property <string> chat-mode: "ask";
    in-out property <bool> has-key: false;
    in-out property <bool> demo: false;
    in-out property <bool> paused: false;
    in-out property <string> workspace-short: "";
    in-out property <string> workspace-full: "";
    in-out property <[string]> starters: [];
    in-out property <int> thread-version: 0;
    // View switching. current-view is the active view id; the content area
    // fades between views.
    in-out property <string> current-view: "chat";
    // Reduced motion: animations run at 0ms while this is on. Default off.
    // Wiring it to the OS setting (or a Settings toggle) is still open.
    in-out property <bool> reduce-motion: false;

    // Views lane (sidebar, Memory, Tasks, Reminders, Awareness, Usage,
    // Activity). Forwarded properties and callbacks the glue in
    // src/bin/desktop/views_slint.rs drives. Every property is in-out so
    // the view and Rust share one value; two-way bindings (<=>) carry the
    // form fields the user edits back to the window. The *-reduce-motion
    // properties and sidebar-current-view are bound to the Shell's own
    // reduce-motion and current-view: the glue never sets them, and the
    // binding keeps the forwarded value live without a second source of
    // truth. See docs/slint-views-bridge.md.
    // Sidebar.
    in-out property <bool> sidebar-reduce-motion: root.reduce-motion;
    in-out property <string> sidebar-current-view: root.current-view;
    in-out property <int> sidebar-unread-count: 0;
    in-out property <int> sidebar-suggestions-count: 0;
    in-out property <int> sidebar-waiting-count: 0;
    in-out property <string> sidebar-footer-text: "";
    in-out property <[SessionRow]> sidebar-sessions: [];
    callback sidebar-navigate(string);
    callback sidebar-open-session(string);
    callback sidebar-new-conversation();
    // Memory.
    in-out property <bool> memory-reduce-motion: root.reduce-motion;
    in-out property <[MemoryRow]> memory-rows: [];
    in-out property <string> memory-search-text: "";
    in-out property <string> memory-new-content: "";
    in-out property <string> memory-new-kind: "";
    in-out property <string> memory-empty-text: "";
    callback memory-add-memory(string, string);
    callback memory-delete-memory(int);
    callback memory-confirm-memory(int);
    callback memory-search-changed(string);
    // Tasks.
    in-out property <bool> tasks-reduce-motion: root.reduce-motion;
    in-out property <[TaskRow]> tasks-rows: [];
    in-out property <string> tasks-new-title: "";
    in-out property <string> tasks-empty-text: "";
    callback tasks-add-task(string);
    callback tasks-set-task-done(int, bool);
    callback tasks-delete-task(int);
    // Reminders.
    in-out property <bool> reminders-reduce-motion: root.reduce-motion;
    in-out property <[ScheduleRow]> reminders-schedules: [];
    in-out property <[InboxRow]> reminders-delivered: [];
    in-out property <string> reminders-schedules-empty-text: "";
    in-out property <string> reminders-delivered-empty-text: "";
    in-out property <string> reminders-form-error: "";
    in-out property <string> reminders-new-what: "";
    in-out property <string> reminders-new-when: "";
    in-out property <string> reminders-new-may: "read";
    in-out property <int> reminders-new-may-index: 0;
    in-out property <bool> reminders-new-quiet: false;
    in-out property <[RunStepRow]> reminders-last-run-steps: [];
    in-out property <string> reminders-last-run-title: "";
    callback reminders-add-schedule(string, string, string, bool);
    callback reminders-cancel-schedule(int);
    callback reminders-run-schedule-now(int);
    callback reminders-set-schedule-may(int, string);
    callback reminders-show-last-run(int);
    callback reminders-fill-daily-briefing();
    callback reminders-fill-inbox-watch();
    // Awareness.
    in-out property <bool> awareness-reduce-motion: root.reduce-motion;
    in-out property <bool> awareness-paused: false;
    in-out property <bool> awareness-watching: false;
    in-out property <bool> awareness-reflecting: false;
    in-out property <string> awareness-workspace: "";
    in-out property <string> awareness-proactive: "off";
    in-out property <string> awareness-proactive-note: "";
    in-out property <[SuggestionRow]> awareness-suggestions: [];
    in-out property <string> awareness-suggestions-empty-text: "";
    in-out property <[SimpleRow]> awareness-right-now: [];
    in-out property <string> awareness-right-now-empty-text: "";
    in-out property <[MemoryRow]> awareness-insights: [];
    in-out property <string> awareness-insights-empty-text: "";
    in-out property <[SimpleRow]> awareness-journal: [];
    in-out property <string> awareness-journal-empty-text: "";
    callback awareness-set-paused(bool);
    callback awareness-set-watching(bool);
    callback awareness-set-reflecting(bool);
    callback awareness-set-proactive(string);
    callback awareness-clear-observations();
    callback awareness-forget-insight(int);
    callback awareness-answer-suggestion(int, string);
    callback awareness-open-suggestion-session(int);
    // Activity.
    in-out property <bool> activity-reduce-motion: root.reduce-motion;
    in-out property <[AuditRow]> activity-rows: [];
    in-out property <string> activity-seal-text: "";
    in-out property <bool> activity-seal-danger: false;
    in-out property <string> activity-empty-text: "";
    // Usage.
    in-out property <bool> usage-reduce-motion: root.reduce-motion;
    in-out property <string> usage-level-note: "";
    in-out property <string> usage-today-big: "";
    in-out property <string> usage-today-small: "";
    in-out property <float> usage-today-frac: -1;
    in-out property <string> usage-today-state: "normal";
    in-out property <string> usage-month-big: "";
    in-out property <string> usage-month-small: "";
    in-out property <float> usage-month-frac: -1;
    in-out property <string> usage-month-state: "normal";
    in-out property <string> usage-heading-big: "";
    in-out property <string> usage-heading-small: "";
    in-out property <bool> usage-provider-visible: false;
    in-out property <string> usage-provider-title: "";
    in-out property <string> usage-provider-big: "";
    in-out property <string> usage-provider-small: "";
    in-out property <float> usage-provider-frac: -1;
    in-out property <string> usage-provider-state: "normal";
    in-out property <[UsageDayRow]> usage-days: [];
    in-out property <string> usage-pace-note: "";
    in-out property <[ModelRow]> usage-models: [];
    in-out property <string> usage-models-empty-text: "";
    in-out property <bool> usage-models-note-visible: false;
    in-out property <bool> usage-daily-visible: false;
    in-out property <[SimpleRow]> usage-daily-rows: [];
    in-out property <string> usage-day-limit: "";
    in-out property <string> usage-month-limit: "";
    in-out property <string> usage-bg-limit: "";
    in-out property <string> usage-bg-note: "";
    in-out property <string> usage-fast-model: "";
    in-out property <string> usage-fast-note: "";
    in-out property <string> usage-main-model: "";
    in-out property <bool> usage-route-checked: false;
    in-out property <string> usage-save-error: "";
    in-out property <bool> usage-saved-visible: false;
    callback usage-save-usage();

    callback send-message(string);
    callback new-session();
    callback cancel-reply();
    callback approve(string, string);
    // Chat callbacks, forwarded to the ChatView's own callbacks.
    callback set-mode(string);
    callback undo();
    callback toggle-step(string);
    callback open-link(string);
    callback use-starter(string);
    callback try-demo();
    callback resume();
    callback continue-turn();
    callback open-settings();
    // Opens the About dialog (a separate native window, shown from Rust).
    callback show-about();
    // Programmatic copy: the shell has no Slint copy API, so Rust copies
    // through the arboard crate (see the bridge contract).
    callback copy-requested(string);

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New conversation";
                activated => { root.new-session(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Copy";
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "About Heron";
                activated => { root.show-about(); }
            }
        }
    }

    HorizontalLayout {
        // Sidebar: brand, New conversation, views, sessions, status. The
        // Views lane's Sidebar replaces the Shell's Phase 0 rail; the glue
        // in src/bin/desktop/views_slint.rs drives it through the
        // forwarded sidebar-* properties and callbacks. The status line
        // under the footer is the Shell's backend status.
        Sidebar {
            width: 240px;
            reduce-motion: root.sidebar-reduce-motion;
            current-view: root.sidebar-current-view;
            unread-count: root.sidebar-unread-count;
            suggestions-count: root.sidebar-suggestions-count;
            waiting-count: root.sidebar-waiting-count;
            footer-text: root.sidebar-footer-text;
            status-text: root.backend-status;
            sessions: root.sidebar-sessions;
            navigate(v) => { root.sidebar-navigate(v); }
            open-session(id) => { root.sidebar-open-session(id); }
            new-conversation => { root.sidebar-new-conversation(); }
        }
        Rectangle {
            width: 1px;
            height: parent.height;
            background: Theme.line;
        }
    }

        // Content area. One branch per view, all present at once so the
        // opacity fade can run on switch; only the current branch takes
        // input (each branch is gated on visible as well as opacity).
        // The chat, awareness, memory, tasks, reminders, usage, and
        // activity branches are real. Onboarding and settings are still
        // scaffolding the Setup lane replaces with its views.
        content := Rectangle {
            horizontal-stretch: 1;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 8px;
                // Opacity alone does not block input, so the branch is
                // also gated on visible: a hidden view must not swallow
                // clicks meant for the view underneath it.
                visible: root.current-view == "chat";
                opacity: root.current-view == "chat" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }

                if root.error-message != "" : Text {
                    text: root.error-message;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                // The Chat lane's view. It owns the header, thread,
                // composer, empty state, and approval cards; Rust owns
                // the state machine behind it (see src/bin/desktop/).
                if root.error-message == "" : ChatView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    title: root.session-title == "" ? "New conversation" : root.session-title;
                    thread: root.messages;
                    busy: root.busy;
                    mode: root.chat-mode;
                    can-undo: root.session-id != "";
                    show-empty: root.messages.length == 0;
                    has-key: root.has-key;
                    demo: root.demo;
                    paused: root.paused;
                    workspace-short: root.workspace-short;
                    workspace-full: root.workspace-full;
                    starters: root.starters;
                    thread-version: root.thread-version;
                    reduce-motion: root.reduce-motion;
                    send-message(t) => { root.send-message(t); }
                    cancel-reply => { root.cancel-reply(); }
                    undo => { root.undo(); }
                    set-mode(m) => { root.set-mode(m); }
                    approve(id, decision) => { root.approve(id, decision); }
                    toggle-step(id) => { root.toggle-step(id); }
                    copy-requested(t) => { root.copy-requested(t); }
                    open-link(url) => { root.open-link(url); }
                    open-settings => { root.open-settings(); }
                    new-session => { root.new-session(); }
                    continue-turn => { root.continue-turn(); }
                    use-starter(s) => { root.use-starter(s); }
                    try-demo => { root.try-demo(); }
                    resume => { root.resume(); }
                }
            }

            // Scaffolding: the Setup lane replaces these two branches
            // with its views.
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 8px;
                opacity: root.current-view == "onboarding" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                Text {
                    text: "Getting to know you";
                    font-family: Theme.heading-font;
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Onboarding arrives with the Setup lane (Phase 3).";
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "awareness";
                opacity: root.current-view == "awareness" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                AwarenessView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.awareness-reduce-motion;
                    paused: root.awareness-paused;
                    watching: root.awareness-watching;
                    reflecting: root.awareness-reflecting;
                    workspace: root.awareness-workspace;
                    proactive: root.awareness-proactive;
                    proactive-note: root.awareness-proactive-note;
                    suggestions: root.awareness-suggestions;
                    suggestions-empty-text: root.awareness-suggestions-empty-text;
                    right-now: root.awareness-right-now;
                    right-now-empty-text: root.awareness-right-now-empty-text;
                    insights: root.awareness-insights;
                    insights-empty-text: root.awareness-insights-empty-text;
                    journal: root.awareness-journal;
                    journal-empty-text: root.awareness-journal-empty-text;
                    set-paused(a0) => { root.awareness-set-paused(a0); }
                    set-watching(a0) => { root.awareness-set-watching(a0); }
                    set-reflecting(a0) => { root.awareness-set-reflecting(a0); }
                    set-proactive(a0) => { root.awareness-set-proactive(a0); }
                    clear-observations() => { root.awareness-clear-observations(); }
                    forget-insight(a0) => { root.awareness-forget-insight(a0); }
                    answer-suggestion(a0, a1) => { root.awareness-answer-suggestion(a0, a1); }
                    open-suggestion-session(a0) => { root.awareness-open-suggestion-session(a0); }
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "memory";
                opacity: root.current-view == "memory" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                MemoryView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.memory-reduce-motion;
                    rows: root.memory-rows;
                    search-text <=> root.memory-search-text;
                    new-content <=> root.memory-new-content;
                    new-kind <=> root.memory-new-kind;
                    empty-text: root.memory-empty-text;
                    add-memory(a0, a1) => { root.memory-add-memory(a0, a1); }
                    delete-memory(a0) => { root.memory-delete-memory(a0); }
                    confirm-memory(a0) => { root.memory-confirm-memory(a0); }
                    search-changed(a0) => { root.memory-search-changed(a0); }
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "tasks";
                opacity: root.current-view == "tasks" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                TasksView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.tasks-reduce-motion;
                    rows: root.tasks-rows;
                    new-title <=> root.tasks-new-title;
                    empty-text: root.tasks-empty-text;
                    add-task(a0) => { root.tasks-add-task(a0); }
                    set-task-done(a0, a1) => { root.tasks-set-task-done(a0, a1); }
                    delete-task(a0) => { root.tasks-delete-task(a0); }
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "reminders";
                opacity: root.current-view == "reminders" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                RemindersView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.reminders-reduce-motion;
                    schedules: root.reminders-schedules;
                    delivered: root.reminders-delivered;
                    schedules-empty-text: root.reminders-schedules-empty-text;
                    delivered-empty-text: root.reminders-delivered-empty-text;
                    form-error: root.reminders-form-error;
                    new-what <=> root.reminders-new-what;
                    new-when <=> root.reminders-new-when;
                    new-may <=> root.reminders-new-may;
                    new-may-index <=> root.reminders-new-may-index;
                    new-quiet <=> root.reminders-new-quiet;
                    last-run-steps: root.reminders-last-run-steps;
                    last-run-title: root.reminders-last-run-title;
                    add-schedule(a0, a1, a2, a3) => { root.reminders-add-schedule(a0, a1, a2, a3); }
                    cancel-schedule(a0) => { root.reminders-cancel-schedule(a0); }
                    run-schedule-now(a0) => { root.reminders-run-schedule-now(a0); }
                    set-schedule-may(a0, a1) => { root.reminders-set-schedule-may(a0, a1); }
                    show-last-run(a0) => { root.reminders-show-last-run(a0); }
                    fill-daily-briefing() => { root.reminders-fill-daily-briefing(); }
                    fill-inbox-watch() => { root.reminders-fill-inbox-watch(); }
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "usage";
                opacity: root.current-view == "usage" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                UsageView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.usage-reduce-motion;
                    level-note: root.usage-level-note;
                    today-big: root.usage-today-big;
                    today-small: root.usage-today-small;
                    today-frac: root.usage-today-frac;
                    today-state: root.usage-today-state;
                    month-big: root.usage-month-big;
                    month-small: root.usage-month-small;
                    month-frac: root.usage-month-frac;
                    month-state: root.usage-month-state;
                    heading-big: root.usage-heading-big;
                    heading-small: root.usage-heading-small;
                    provider-visible: root.usage-provider-visible;
                    provider-title: root.usage-provider-title;
                    provider-big: root.usage-provider-big;
                    provider-small: root.usage-provider-small;
                    provider-frac: root.usage-provider-frac;
                    provider-state: root.usage-provider-state;
                    days: root.usage-days;
                    pace-note: root.usage-pace-note;
                    models: root.usage-models;
                    models-empty-text: root.usage-models-empty-text;
                    models-note-visible: root.usage-models-note-visible;
                    daily-visible <=> root.usage-daily-visible;
                    daily-rows: root.usage-daily-rows;
                    day-limit <=> root.usage-day-limit;
                    month-limit <=> root.usage-month-limit;
                    bg-limit <=> root.usage-bg-limit;
                    bg-note: root.usage-bg-note;
                    fast-model <=> root.usage-fast-model;
                    fast-note: root.usage-fast-note;
                    main-model: root.usage-main-model;
                    route-checked <=> root.usage-route-checked;
                    save-error: root.usage-save-error;
                    saved-visible: root.usage-saved-visible;
                    save-usage() => { root.usage-save-usage(); }
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                visible: root.current-view == "activity";
                opacity: root.current-view == "activity" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                ActivityView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    reduce-motion: root.activity-reduce-motion;
                    rows: root.activity-rows;
                    seal-text: root.activity-seal-text;
                    seal-danger: root.activity-seal-danger;
                    empty-text: root.activity-empty-text;
                }
            }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 8px;
                opacity: root.current-view == "settings" ? 1 : 0;
                animate opacity { duration: root.reduce-motion ? 0ms : 180ms; easing: ease-in-out; }
                Text {
                    text: "Settings";
                    font-family: Theme.heading-font;
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Settings arrive with the Setup lane (Phase 3).";
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
