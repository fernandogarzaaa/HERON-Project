// Heron tasks view. One file per view: the Shell's MainWindow drives
// the views only through its own forwarded properties and callbacks, so
// each view keeps its own file and its own component.

import { CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { LineEdit } from "../components/line_edit.slint";
import { Button } from "../components/button.slint";
import { TaskRow, SectionTitle, SectionIntro, RowMeta, EmptyNote, RowCard } from "common.slint";
import { Theme } from "../components/theme.slint";
import { WrapText } from "../components/wrap_text.slint";

export component TasksView inherits Rectangle {
    in property <[TaskRow]> rows;
    in-out property <string> new-title: "";
    in property <string> empty-text: "";
    in property <string> save-error: "";
    in property <bool> reduce-motion: false;
    callback add-task(string);
    callback set-task-done(int, bool);
    callback delete-task(int);

    out property <length> overflow-x: scroll.overflow-x;
    out property <length> overflow-y: scroll.overflow-y;
    public function scroll-to-end() { scroll.content-y = -scroll.overflow-y; }

    scroll := PageScroll {
        width: parent.width;
        height: parent.height;
        VerticalBox {
            width: parent.width;
            padding: 28px;
            alignment: start;
            spacing: 14px;
            SectionTitle { title: "Tasks"; }
            SectionIntro { body: "Your to-do list. Heron can add to it and tick things off when you ask."; }
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Add a task";
                    text <=> root.new-title;
                    accepted => { root.add-task(root.new-title); }
                }
                Button { reduce-motion: root.reduce-motion;
                    text: "Add task";
                    primary: true;
                    clicked => { root.add-task(root.new-title); }
                }
            }
            if root.save-error != "": WrapText { text: root.save-error; color: Theme.danger; }
            if root.empty-text != "": EmptyNote { body: root.empty-text; }
            for row in root.rows: RowCard {
                reduce-motion: root.reduce-motion;
                HorizontalBox {
                    width: parent.width;
                    padding: 10px;
                    spacing: 10px;
                    CheckBox {
                        checked: row.done;
                        toggled => { root.set-task-done(row.id, self.checked); }
                    }
                    VerticalBox {
                        padding: 0px;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        WrapText {
                            text: row.title;
                            font-size: 15px;
                            color: row.done ? Theme.muted : Theme.ink;
                            animate color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-in-out; }
                        }
                        if row.meta != "": RowMeta { body: row.meta; }
                    }
                    Button { reduce-motion: root.reduce-motion;
                        text: "Remove";
                        clicked => { root.delete-task(row.id); }
                    }
                }
            }
        }
    }
}

