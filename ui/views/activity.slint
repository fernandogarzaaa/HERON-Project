// Heron activity log view. One file per view: the Shell's MainWindow drives
// the views only through its own forwarded properties and callbacks, so
// each view keeps its own file and its own component.

import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { WrapText } from "../components/wrap_text.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { AuditRow, SectionTitle, SectionIntro, EmptyNote, RowCard } from "common.slint";
import { Theme } from "../components/theme.slint";

export component ActivityView inherits Rectangle {
    in property <[AuditRow]> rows;
    in property <string> seal-text: "";
    in property <bool> seal-danger: false;
    in property <string> empty-text: "";
    in property <bool> reduce-motion: false;

    out property <length> overflow-x: scroll.overflow-x;
    out property <length> overflow-y: scroll.overflow-y;
    public function scroll-to-end() { scroll.content-y = -scroll.overflow-y; }

    scroll := PageScroll {
        width: parent.width;
        height: parent.height;
        VerticalBox {
            width: parent.width;
            padding: 28px;
            alignment: start;
            spacing: 14px;
            SectionTitle { title: "Activity log"; }
            SectionIntro { body: "Every action Heron took or was refused, newest first. Passwords and keys are blanked out before anything is logged."; }
            if root.seal-text != "": Text {
                text: root.seal-text;
                font-size: 14px;
                color: root.seal-danger ? Theme.danger : Theme.muted;
                wrap: TextWrap.word-wrap;
            }
            if root.empty-text != "": EmptyNote { body: root.empty-text; }
            if root.rows.length > 0: HorizontalBox {
                // Column headers line up with the cell text inside each
                // RowCard: 1px border plus 10px padding.
                padding-left: 11px;
                padding-right: 11px;
                padding-top: 0px;
                padding-bottom: 0px;
                spacing: 10px;
                Text { text: "When"; font-size: 13px; font-weight: 600; color: Theme.muted; width: 110px; }
                Text { text: "Action"; font-size: 13px; font-weight: 600; color: Theme.muted; width: 140px; }
                Text { text: "Details"; font-size: 13px; font-weight: 600; color: Theme.muted; horizontal-stretch: 1; }
                Text { text: "Outcome"; font-size: 13px; font-weight: 600; color: Theme.muted; width: 130px; }
            }
            for row in root.rows: RowCard {
                reduce-motion: root.reduce-motion;
                HorizontalBox {
                    width: parent.width;
                    padding: 10px;
                    spacing: 10px;
                    Text { text: row.when; font-size: 14px; color: Theme.ink; width: 110px; }
                    WrapText { text: row.action; font-size: 14px; color: Theme.ink; width: 140px; }
                    // WrapText: a path or JSON chunk with no break point must not
                    // widen the row (Linux breaks paths at fewer places than macOS).
                    WrapText { text: row.details; font-size: 14px; font-family: "SF Mono"; color: Theme.ink; horizontal-stretch: 1; }
                    WrapText { text: row.outcome; font-size: 14px; color: row.denied ? Theme.danger : Theme.ink; width: 130px; }
                }
            }
        }
    }
}
