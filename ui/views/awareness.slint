// Heron awareness view. One file per view: the Shell's MainWindow drives
// the views only through its own forwarded properties and callbacks, so
// each view keeps its own file and its own component.

import { CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { Button } from "../components/button.slint";
import { SuggestionRow, SimpleRow, MemoryRow, SectionTitle, SectionIntro, RowMeta, EmptyNote, Spacer, RowCard } from "common.slint";
import { Theme } from "../components/theme.slint";
import { ChoiceChip } from "../components/atoms.slint";

export component AwarenessView inherits Rectangle {
    in property <bool> paused: false;
    in property <bool> reduce-motion: false;
    in property <bool> watching: false;
    in property <bool> reflecting: false;
    in property <string> workspace: "";
    in property <string> proactive: "off";
    in property <string> proactive-note: "";
    // A high-impact change is never submitted on its first click.
    in-out property <bool> confirm-takeover: false;
    in-out property <bool> confirm-clear: false;
    in property <[SuggestionRow]> suggestions;
    in property <string> suggestions-empty-text: "";
    in property <[SimpleRow]> right-now;
    in property <string> right-now-empty-text: "";
    in property <[MemoryRow]> insights;
    in property <string> insights-empty-text: "";
    in property <[SimpleRow]> journal;
    in property <string> journal-empty-text: "";
    callback set-paused(bool);
    callback set-watching(bool);
    callback set-reflecting(bool);
    callback set-proactive(string);
    callback clear-observations();
    callback forget-insight(int);
    callback answer-suggestion(int, string);
    callback open-suggestion-session(int);

    out property <length> overflow-x: scroll.overflow-x;
    out property <length> overflow-y: scroll.overflow-y;
    public function scroll-to-end() { scroll.content-y = -scroll.overflow-y; }

    scroll := PageScroll {
        width: parent.width;
        height: parent.height;
        VerticalBox {
            width: parent.width;
            padding: 28px;
            alignment: start;
            spacing: 14px;
            SectionTitle { title: "Awareness"; }
            SectionIntro { body: "While Heron is open, it quietly watches your working folder so it already knows what you are in the middle of. It sees file names and times, never what is inside, and never passwords or key files. Everything it notices stays on this computer."; }
            CheckBox {
                text: "Pause everything Heron does on its own";
                checked: root.paused;
                toggled => { root.set-paused(self.checked); }
            }
            Text {
                text: "Reminders, watches, suggestions and background checks all stop until you switch this off. From your phone, send /pause or /resume.";
                font-size: 14px;
                color: Theme.muted;
                wrap: TextWrap.word-wrap;
            }
            CheckBox {
                text: "Watch my folder in the background";
                checked: root.watching;
                toggled => { root.set-watching(self.checked); }
            }
            if root.workspace != "": Text {
                text: "Watching " + root.workspace;
                font-size: 14px;
                color: Theme.muted;
                wrap: TextWrap.word-wrap;
            }
            CheckBox {
                text: "Think about what it notices";
                checked: root.reflecting;
                enabled: root.watching;
                toggled => { root.set-reflecting(self.checked); }
            }
            Spacer { height: 16px; }
            Text {
                text: "How much Heron does on its own";
                font-size: 19px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                alignment: start;
                ChoiceChip { label: "Only when I ask"; selected: root.proactive == "off"; enabled: root.watching; reduce-motion: root.reduce-motion; clicked => { root.set-proactive("off"); } }
                ChoiceChip { label: "Suggest work"; selected: root.proactive == "suggest"; enabled: root.watching; reduce-motion: root.reduce-motion; clicked => { root.set-proactive("suggest"); } }
                ChoiceChip { label: "Prepare ahead"; selected: root.proactive == "prepare"; enabled: root.watching; reduce-motion: root.reduce-motion; clicked => { root.set-proactive("prepare"); } }
                ChoiceChip { label: "Take over"; selected: root.proactive == "takeover"; enabled: root.watching; reduce-motion: root.reduce-motion; clicked => { if (root.proactive != "takeover") { root.confirm-takeover = true; } } }
            }
            if root.confirm-takeover: Rectangle {
                background: Theme.danger-soft;
                border-color: Theme.danger;
                border-width: 1px;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Take over lets Heron create and edit files in your working folder without asking first. Continue?";
                        color: Theme.ink;
                        wrap: TextWrap.word-wrap;
                    }
                    HorizontalBox {
                        alignment: start;
                        padding: 0px;
                        Button { reduce-motion: root.reduce-motion; text: "Confirm take over"; clicked => { root.confirm-takeover = false; root.set-proactive("takeover"); } }
                        Button { reduce-motion: root.reduce-motion; text: "Cancel"; clicked => { root.confirm-takeover = false; } }
                    }
                }
            }
            if root.proactive-note != "": Text {
                text: root.proactive-note;
                font-size: 13px;
                color: Theme.muted;
                wrap: TextWrap.word-wrap;
            }
            Spacer { height: 16px; }
            Text {
                text: "Heron suggests";
                font-size: 19px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
            if root.suggestions-empty-text != "": EmptyNote { body: root.suggestions-empty-text; }
            for s in root.suggestions: RowCard {
                reduce-motion: root.reduce-motion;
                VerticalBox {
                    width: parent.width;
                    padding: 12px;
                    spacing: 4px;
                    Text {
                        text: s.title;
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.ink;
                        wrap: TextWrap.word-wrap;
                    }
                    if s.why != "": Text {
                        text: s.why;
                        font-size: 14px;
                        color: Theme.muted;
                        wrap: TextWrap.word-wrap;
                    }
                    if s.result != "": Text {
                        text: s.result;
                        font-size: 14px;
                        color: Theme.ink;
                        wrap: TextWrap.word-wrap;
                    }
                    HorizontalBox {
                        alignment: start;
                        padding: 0px;
                        spacing: 8px;
                        if s.status == "new": Button { reduce-motion: root.reduce-motion;
                            text: "Do it";
                            clicked => { root.answer-suggestion(s.id, "accept"); }
                        }
                        if s.has-session: Button { reduce-motion: root.reduce-motion;
                            text: s.status == "done" ? "Review what changed" : "Continue in a conversation";
                            clicked => { root.open-suggestion-session(s.id); }
                        }
                        Button { reduce-motion: root.reduce-motion;
                            text: s.status == "new" ? "Not now" : s.status == "done" ? "Got it" : "Dismiss";
                            clicked => { root.answer-suggestion(s.id, "dismiss"); }
                        }
                    }
                }
            }
            Spacer { height: 16px; }
            Text {
                text: "Right now";
                font-size: 19px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
            if root.right-now-empty-text != "": EmptyNote { body: root.right-now-empty-text; }
            for row in root.right-now: HorizontalBox {
                padding: 0px;
                spacing: 12px;
                Text { text: row.text; font-size: 15px; color: Theme.ink; wrap: TextWrap.word-wrap; horizontal-stretch: 1; }
                if row.meta != "": RowMeta { body: row.meta; }
            }
            Spacer { height: 16px; }
            Text {
                text: "What Heron has concluded";
                font-size: 19px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
            if root.insights-empty-text != "": EmptyNote { body: root.insights-empty-text; }
            for row in root.insights: RowCard {
                reduce-motion: root.reduce-motion;
                HorizontalBox {
                    width: parent.width;
                    padding: 10px;
                    spacing: 10px;
                    VerticalBox {
                        padding: 0px;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: row.content; font-size: 15px; color: Theme.ink; wrap: TextWrap.word-wrap; }
                        RowMeta { body: row.meta; }
                    }
                    Button { reduce-motion: root.reduce-motion;
                        text: "Forget";
                        clicked => { root.forget-insight(row.id); }
                    }
                }
            }
            Spacer { height: 16px; }
            Text {
                text: "Recently noticed";
                font-size: 19px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
            if root.journal-empty-text != "": EmptyNote { body: root.journal-empty-text; }
            for row in root.journal: HorizontalBox {
                padding: 0px;
                spacing: 12px;
                Text { text: row.text; font-size: 15px; color: Theme.ink; wrap: TextWrap.word-wrap; horizontal-stretch: 1; }
                RowMeta { body: row.meta; }
            }
            HorizontalBox {
                padding: 0px;
                alignment: start;
                Button { reduce-motion: root.reduce-motion;
                    text: "Forget everything observed";
                    clicked => { root.confirm-clear = true; }
                }
            }
            if root.confirm-clear: Rectangle {
                background: Theme.danger-soft;
                border-color: Theme.danger;
                border-width: 1px;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Forget all observations and conclusions? Information you told Heron directly is kept.";
                        color: Theme.ink;
                        wrap: TextWrap.word-wrap;
                    }
                    HorizontalBox {
                        alignment: start;
                        padding: 0px;
                        Button { reduce-motion: root.reduce-motion; text: "Yes, forget observations"; clicked => { root.confirm-clear = false; root.clear-observations(); } }
                        Button { reduce-motion: root.reduce-motion; text: "Cancel"; clicked => { root.confirm-clear = false; } }
                    }
                }
            }
        }
    }
}
