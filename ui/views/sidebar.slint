// Heron sidebar view. One file per view: the Slint compiler generates
// Rust code only for the last exported component of a file, so the
// five views cannot share one file and still be driven from Rust.

import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, SessionRow, Spacer } from "common.slint";

export component Sidebar inherits Rectangle {
    background: Theme.paper;
    in property <string> current-view: "chat";
    in property <bool> reduce-motion: false;
    in property <int> unread-count: 0;
    in property <int> suggestions-count: 0;
    in property <int> waiting-count: 0;
    in property <string> footer-text: "";
    in property <[SessionRow]> sessions;
    callback navigate(string);
    callback open-session(string);
    callback new-conversation();

    VerticalBox {
        width: parent.width;
        height: parent.height;
        padding: 18px;
        spacing: 6px;
        HorizontalBox {
            spacing: 10px;
            Text {
                text: "Heron";
                font-size: 21px;
                font-family: "Georgia";
                font-weight: 600;
                color: Theme.ink;
            }
        }
        Button {
            text: "New conversation";
            primary: true;
            clicked => { root.new-conversation(); }
        }
        VerticalBox {
            spacing: 1px;
            padding-top: 8px;
            Button { text: root.waiting-count > 0 ? "Conversation ({root.waiting-count})" : "Conversation"; checkable: true; checked: root.current-view == "chat"; clicked => { root.navigate("chat"); } }
            Button { text: "Getting to know you"; checkable: true; checked: root.current-view == "onboarding"; clicked => { root.navigate("onboarding"); } }
            Button { text: root.suggestions-count > 0 ? "Awareness ({root.suggestions-count})" : "Awareness"; checkable: true; checked: root.current-view == "awareness"; clicked => { root.navigate("awareness"); } }
            Button { text: "Memory"; checkable: true; checked: root.current-view == "memory"; clicked => { root.navigate("memory"); } }
            Button { text: "Tasks"; checkable: true; checked: root.current-view == "tasks"; clicked => { root.navigate("tasks"); } }
            Button { text: root.unread-count > 0 ? "Reminders ({root.unread-count})" : "Reminders"; checkable: true; checked: root.current-view == "reminders"; clicked => { root.navigate("reminders"); } }
            Button { text: "Usage"; checkable: true; checked: root.current-view == "usage"; clicked => { root.navigate("usage"); } }
            Button { text: "Activity log"; checkable: true; checked: root.current-view == "activity"; clicked => { root.navigate("activity"); } }
            Button { text: "Settings"; checkable: true; checked: root.current-view == "settings"; clicked => { root.navigate("settings"); } }
        }
        Text {
            text: "Recent conversations";
            font-size: 13px;
            font-weight: 600;
            color: Theme.muted;
        }
        for session in root.sessions: Button {
            text: session.title;
            checkable: true;
            checked: session.current;
            clicked => { root.open-session(session.id); }
        }
        Spacer { height: 10px; }
        Text {
            text: root.footer-text;
            font-size: 12px;
            color: Theme.muted;
            wrap: TextWrap.word-wrap;
        }
    }
}

