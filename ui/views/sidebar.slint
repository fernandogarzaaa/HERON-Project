// Heron sidebar view. One file per view: the Shell's MainWindow drives
// the views only through its own forwarded properties and callbacks, so
// each view keeps its own file and its own component.

import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Button } from "../components/button.slint";
import { SessionRow, Spacer } from "common.slint";
import { NavItem } from "../components/atoms.slint";
import { Theme } from "../components/theme.slint";

export component Sidebar inherits Rectangle {
    background: Theme.paper;
    in property <string> current-view: "chat";
    in property <bool> reduce-motion: false;
    in property <int> unread-count: 0;
    in property <int> suggestions-count: 0;
    in property <int> waiting-count: 0;
    in property <string> footer-text: "";
    // The Shell's backend status line ("Heron · model · mode", or the
    // "Connected, but the server state could not be read" error). The
    // footer above carries the model and token count; this line carries
    // the connection state. The Shell posts it from its state poll.
    in property <string> status-text: "";
    in property <[SessionRow]> sessions;
    callback navigate(string);
    callback open-session(string);
    callback new-conversation();

    VerticalBox {
        width: parent.width;
        height: parent.height;
        padding: 18px;
        spacing: 6px;
        HorizontalBox {
            padding: 0px;
            padding-bottom: 10px;
            spacing: 10px;
            Text {
                text: "Heron";
                font-size: 21px;
                font-family: Theme.heading-font;
                font-weight: 600;
                color: Theme.ink;
            }
        }
        Button { reduce-motion: root.reduce-motion;
            text: "New conversation";
            icon: @image-url("../icons/plus.svg");
            primary: true;
            clicked => { root.new-conversation(); }
        }
        VerticalBox {
            spacing: 1px;
            padding-top: 8px;
            NavItem { icon: @image-url("../icons/chat.svg"); label: root.waiting-count > 0 ? "Conversation ({root.waiting-count})" : "Conversation"; selected: root.current-view == "chat"; reduce-motion: root.reduce-motion; clicked => { root.navigate("chat"); } }
            NavItem { icon: @image-url("../icons/sparkles.svg"); label: "Getting to know you"; selected: root.current-view == "onboarding"; reduce-motion: root.reduce-motion; clicked => { root.navigate("onboarding"); } }
            NavItem { icon: @image-url("../icons/activity.svg"); label: root.suggestions-count > 0 ? "Awareness ({root.suggestions-count})" : "Awareness"; selected: root.current-view == "awareness"; reduce-motion: root.reduce-motion; clicked => { root.navigate("awareness"); } }
            NavItem { icon: @image-url("../icons/memory.svg"); label: "Memory"; selected: root.current-view == "memory"; reduce-motion: root.reduce-motion; clicked => { root.navigate("memory"); } }
            NavItem { icon: @image-url("../icons/tasks.svg"); label: "Tasks"; selected: root.current-view == "tasks"; reduce-motion: root.reduce-motion; clicked => { root.navigate("tasks"); } }
            NavItem { icon: @image-url("../icons/reminders.svg"); label: root.unread-count > 0 ? "Reminders ({root.unread-count})" : "Reminders"; selected: root.current-view == "reminders"; reduce-motion: root.reduce-motion; clicked => { root.navigate("reminders"); } }
            NavItem { icon: @image-url("../icons/usage.svg"); label: "Usage"; selected: root.current-view == "usage"; reduce-motion: root.reduce-motion; clicked => { root.navigate("usage"); } }
            NavItem { icon: @image-url("../icons/activity.svg"); label: "Activity log"; selected: root.current-view == "activity"; reduce-motion: root.reduce-motion; clicked => { root.navigate("activity"); } }
            NavItem { icon: @image-url("../icons/settings.svg"); label: "Settings"; selected: root.current-view == "settings"; reduce-motion: root.reduce-motion; clicked => { root.navigate("settings"); } }
        }
        Text {
            text: "Recent conversations";
            font-size: 13px;
            font-weight: 600;
            color: Theme.muted;
        }
        // The session list scrolls independently. Without this bounded
        // region many sessions push the model/status footer off-screen
        // at the window's minimum height.
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: as-needed;
            VerticalBox {
                width: parent.width;
                spacing: 4px;
                // Rows keep their own height; without this a short list
                // stretches each row to fill the scroll region.
                alignment: start;
                if root.sessions.length == 0: Text {
                    text: "No recent conversations";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for session in root.sessions: NavItem {
                    has-icon: false;
                    label: session.title;
                    selected: session.current;
                    reduce-motion: root.reduce-motion;
                    clicked => { root.open-session(session.id); }
                }
            }
        }
        Spacer { height: 10px; }
        Text {
            text: root.footer-text;
            font-size: 12px;
            color: Theme.muted;
            wrap: TextWrap.word-wrap;
        }
        if root.status-text != "": Text {
            text: root.status-text;
            font-size: 12px;
            color: Theme.muted;
            wrap: TextWrap.word-wrap;
        }
    }
}

