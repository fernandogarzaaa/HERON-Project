// Heron sidebar view. One file per view: the Shell's MainWindow drives
// the views only through its own forwarded properties and callbacks, so
// each view keeps its own file and its own component.

import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SessionRow, Spacer } from "common.slint";
import { Theme } from "../components/theme.slint";

export component Sidebar inherits Rectangle {
    background: Theme.paper;
    in property <string> current-view: "chat";
    in property <bool> reduce-motion: false;
    in property <int> unread-count: 0;
    in property <int> suggestions-count: 0;
    in property <int> waiting-count: 0;
    in property <string> footer-text: "";
    // The Shell's backend status line ("Heron · model · mode", or the
    // "Connected, but the server state could not be read" error). The
    // footer above carries the model and token count; this line carries
    // the connection state. The Shell posts it from its state poll.
    in property <string> status-text: "";
    in property <[SessionRow]> sessions;
    callback navigate(string);
    callback open-session(string);
    callback new-conversation();

    VerticalBox {
        width: parent.width;
        height: parent.height;
        padding: 18px;
        spacing: 6px;
        HorizontalBox {
            spacing: 10px;
            Text {
                text: "Heron";
                font-size: 21px;
                font-family: "Georgia";
                font-weight: 600;
                color: Theme.ink;
            }
        }
        Button {
            text: "New conversation";
            icon: @image-url("../icons/plus.svg");
            icon-size: 17px;
            colorize-icon: true;
            primary: true;
            clicked => { root.new-conversation(); }
        }
        VerticalBox {
            spacing: 1px;
            padding-top: 8px;
            Button { icon: @image-url("../icons/chat.svg"); icon-size: 17px; colorize-icon: true; text: root.waiting-count > 0 ? "Conversation ({root.waiting-count})" : "Conversation"; checkable: true; checked: root.current-view == "chat"; clicked => { root.navigate("chat"); } }
            Button { icon: @image-url("../icons/sparkles.svg"); icon-size: 17px; colorize-icon: true; text: "Getting to know you"; checkable: true; checked: root.current-view == "onboarding"; clicked => { root.navigate("onboarding"); } }
            Button { icon: @image-url("../icons/activity.svg"); icon-size: 17px; colorize-icon: true; text: root.suggestions-count > 0 ? "Awareness ({root.suggestions-count})" : "Awareness"; checkable: true; checked: root.current-view == "awareness"; clicked => { root.navigate("awareness"); } }
            Button { icon: @image-url("../icons/memory.svg"); icon-size: 17px; colorize-icon: true; text: "Memory"; checkable: true; checked: root.current-view == "memory"; clicked => { root.navigate("memory"); } }
            Button { icon: @image-url("../icons/tasks.svg"); icon-size: 17px; colorize-icon: true; text: "Tasks"; checkable: true; checked: root.current-view == "tasks"; clicked => { root.navigate("tasks"); } }
            Button { icon: @image-url("../icons/reminders.svg"); icon-size: 17px; colorize-icon: true; text: root.unread-count > 0 ? "Reminders ({root.unread-count})" : "Reminders"; checkable: true; checked: root.current-view == "reminders"; clicked => { root.navigate("reminders"); } }
            Button { icon: @image-url("../icons/usage.svg"); icon-size: 17px; colorize-icon: true; text: "Usage"; checkable: true; checked: root.current-view == "usage"; clicked => { root.navigate("usage"); } }
            Button { icon: @image-url("../icons/activity.svg"); icon-size: 17px; colorize-icon: true; text: "Activity log"; checkable: true; checked: root.current-view == "activity"; clicked => { root.navigate("activity"); } }
            Button { icon: @image-url("../icons/settings.svg"); icon-size: 17px; colorize-icon: true; text: "Settings"; checkable: true; checked: root.current-view == "settings"; clicked => { root.navigate("settings"); } }
        }
        Text {
            text: "Recent conversations";
            font-size: 13px;
            font-weight: 600;
            color: Theme.muted;
        }
        // The session list scrolls independently. Without this bounded
        // region many sessions push the model/status footer off-screen
        // at the window's minimum height.
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: as-needed;
            VerticalBox {
                width: parent.width;
                spacing: 4px;
                if root.sessions.length == 0: Text {
                    text: "No recent conversations";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for session in root.sessions: Button {
                    text: session.title;
                    checkable: true;
                    checked: session.current;
                    clicked => { root.open-session(session.id); }
                }
            }
        }
        Spacer { height: 10px; }
        Text {
            text: root.footer-text;
            font-size: 12px;
            color: Theme.muted;
            wrap: TextWrap.word-wrap;
        }
        Text {
            visible: root.status-text != "";
            text: root.status-text;
            font-size: 12px;
            color: Theme.muted;
            wrap: TextWrap.word-wrap;
        }
    }
}

