// Shared bits for the Heron views: palette, row structs, section helpers.
// Imported by every ui/views/<view>.slint file. No component here is driven
// from Rust directly; the Shell's MainWindow forwards what Rust needs.

// Heron views: sidebar, Memory, Tasks, Reminders, Awareness, Activity, Usage.
// Drafted by the Views lane. The Shell lane owns the app window, the
// navigation switching, and the bridge that feeds these components data.
// Visual language follows assets/index.html: dark palette, slate blue
// primary, amber accent, serif headings.
//
// The Theme values are Heron's dark palette, measured from the web UI's
// dark media query (assets/index.html lines 22-25) and identical to the
// Shell's ui/components/theme.slint. The integration keeps one copy of
// the Theme; until then this file carries the same values so the views
// render dark on their own. Headings use Georgia, the last family in the
// heading stack: Slint takes one family string, so the full comma list
// from the Shell's heading-font property cannot be used here.

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export global Theme {
    in-out property <color> paper: #10181F;
    in-out property <color> surface: #17212A;
    in-out property <color> ink: #E3EAF0;
    in-out property <color> muted: #93A4B3;
    in-out property <color> line: #293642;
    in-out property <color> slate: #7DB3D8;
    in-out property <color> slate-ink: #0D1B26;
    in-out property <color> slate-soft: #1D3040;
    in-out property <color> talon: #EDB92B;
    in-out property <color> talon-soft: #352C0F;
    in-out property <color> talon-ink: #F6E3A6;
    in-out property <color> danger: #EC7A6F;
    in-out property <color> danger-soft: #3A1D1A;
    in-out property <color> ok: #6EC49C;
}

export struct SessionRow {
    id: string,
    title: string,
    updated: string,
    messages: int,
    current: bool,
}

export struct MemoryRow {
    id: int,
    kind-label: string,
    content: string,
    meta: string,
    confirmed: bool,
}

export struct TaskRow {
    id: int,
    title: string,
    meta: string,
    done: bool,
}

export struct ScheduleRow {
    id: int,
    title: string,
    meta: string,
    outline: string,
    has-outline: bool,
    has-last-run: bool,
    uses-model: bool,
    may: string,
}

export struct RunStepRow {
    text: string,
    failed: bool,
}

export struct InboxRow {
    title: string,
    body: styled-text,
    meta: string,
}

export struct SuggestionRow {
    id: int,
    title: string,
    why: string,
    result: string,
    status: string,
    has-session: bool,
}

export struct ApprovalRow {
    id: int,
    title: string,
    why: string,
    detail: string,
    tainted: bool,
}

export struct SimpleRow {
    text: string,
    meta: string,
}

export struct AuditRow {
    when: string,
    action: string,
    details: string,
    outcome: string,
    denied: bool,
}

export struct UsageDayRow {
    label: string,
    tokens: string,
    frac: float,
    today: bool,
}

export struct ModelRow {
    model: string,
    sent: string,
    written: string,
    calls: string,
}


export component SectionTitle inherits Text {
    in property <string> title;
    text: title;
    font-size: 30px;
    font-family: "Georgia";
    font-weight: 600;
    color: Theme.ink;
}

export component SectionIntro inherits Text {
    in property <string> body;
    text: body;
    font-size: 16px;
    color: Theme.muted;
    wrap: TextWrap.word-wrap;
}

export component RowMeta inherits Text {
    in property <string> body;
    text: body;
    font-size: 13px;
    color: Theme.muted;
    wrap: TextWrap.word-wrap;
}

export component EmptyNote inherits Text {
    in property <string> body;
    text: body;
    font-size: 15px;
    color: Theme.muted;
}

export component Spacer inherits Rectangle {
    height: 14px;
}

export component KindTag inherits Rectangle {
    in property <string> label;
    background: transparent;
    border-color: Theme.slate;
    border-width: 1px;
    border-radius: 5px;
    height: 20px;
    width: tag-text.width + 12px;
    tag-text := Text {
        text: label;
        font-size: 12px;
        color: Theme.slate;
        x: 6px;
        height: 20px;
        vertical-alignment: center;
    }
}

