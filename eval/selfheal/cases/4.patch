+#[cfg(test)]
+mod selfheal_hidden_case_4 {
+    use super::*;
+    use crate::config::Config;
+    use crate::llm::ScriptedLlm;
+    use crate::permissions::Effect;
+    use crate::store::Store;
+
+    #[tokio::test]
+    async fn selfheal_hidden_case_4() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut cfg = Config::default();
+        cfg.home = dir.path().join("home");
+        let app = Arc::new(App::assemble(
+            cfg, dir.path().join("ws"), Store::in_memory().unwrap(), Arc::new(ScriptedLlm::new(vec![])),
+        ).await.unwrap());
+        let code = pairing_code(&app);
+        app.store.kv_set("telegram_chat", "42").unwrap();
+        let bot = Bot {
+            client: reqwest::Client::new(),
+            base: "http://127.0.0.1:1/botDISABLED".into(),
+            app: app.clone(),
+            account_id: "hidden-case-bot".into(),
+            pairing_epoch: code,
+            spool: ChannelStore::open(&app.cfg().home.join("channels.db")).unwrap(),
+            dispatch_lock: Arc::new(tokio::sync::Mutex::new(())),
+        };
+        // The owner unpairs while a turn that started earlier is still running.
+        unpair(&app);
+        let shared = Arc::<Shared>::default();
+        let approver = TelegramApprover { bot, chat: 42, shared: shared.clone() };
+        let approval = approver.approve(&ApprovalRequest {
+            tool: "write_file".into(),
+            summary: "change a file".into(),
+            risk: Effect::WorkspaceWrite,
+            detail: "must never reach the former owner".into(),
+            tainted: false,
+            args: json!({"path": "notes.txt"}),
+            session_id: "stale-turn".into(),
+        }).await;
+        assert!(matches!(&approval, Approval::Deny(Some(reason)) if reason.contains("revoked")), "{approval:?}");
+        assert!(shared.pending.lock().unwrap().is_none());
+    }
+}
